# OpenAI API 키 (필수)
OPENAI_API_KEY=sk-...

# JWT 서명 키 (필수) — 임의의 긴 랜덤 문자열로 설정하세요.
# 예) python -c "import secrets; print(secrets.token_urlsafe(48))"
# 미설정 시 서버가 시작하지 않습니다.
SECRET_KEY=

# 소셜 로그인 (GitHub OAuth) — 사용 시 필수.
# GitHub > Settings > Developer settings > OAuth Apps 에서 앱 등록 후 발급.
#   - Authorization callback URL: http://localhost:8000/api/user/oauth/github/callback
# 미설정 시 서버는 정상 기동하되 GitHub 로그인만 비활성화됩니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 아래 두 개는 기본값이 있어 로컬에선 생략 가능
# GITHUB_REDIRECT_URI=http://localhost:8000/api/user/oauth/github/callback
# FRONTEND_URL=http://localhost:3000

# 소셜 로그인 (Google OAuth) — 사용 시 필수.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   - Authorized redirect URI: http://localhost:8000/api/user/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/user/oauth/google/callback

# LangSmith 트레이싱 (선택 - 디버깅용). 사용하지 않으면 false 로 두세요.
# true 인데 LANGCHAIN_API_KEY가 유효하지 않으면 403 경고 로그가 반복됩니다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=cloud-automation-chatbot

# 에이전트별 LLM 모델 (선택 - 미설정 시 gpt-4o-mini)
# AI_MODEL_DESIGN=gpt-4o-mini
# AI_MODEL_DEVELOP=gpt-5.6-luna
# AI_MODEL_VERIFY=gpt-5.6-luna
# AI_MODEL_RAG=gpt-4o-mini
# reasoning 모델(gpt-5*/o*)의 추론 강도 (none/low/medium/high, 기본 low)
# AI_REASONING_EFFORT=low
